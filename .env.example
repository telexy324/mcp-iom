PORT=8080
GIN_MODE=debug
DATA_MODE=mock
MCP_PATH=/mcp
MCP_AUTH_TOKEN=
MCP_LISTEN_ADDR=127.0.0.1
MOCK_DATA_DIR=testdata/mock
# HTTP mode requires an explicitly approved system scope
ALLOWED_SYSTEM_IDS=
OPS_API_BASE_URL=
OPS_CMDB_PATH=/api/cmdb/systems/{system_id}
OPS_CHANGES_PATH=/api/changes
OPS_ALERTS_PATH=/api/alerts
OPS_API_HEADER_NAME=api_key
OPS_API_HEADER_VALUE=
HTTP_TIMEOUT_SECONDS=10
MAX_QUERY_DAYS=7
MAX_RESULTS=100
MAX_RESPONSE_BYTES=1048576
MAX_TEXT_LENGTH=1024
LOG_LEVEL=info
